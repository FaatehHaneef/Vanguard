};
const background = sky[name] ?? "#d8ecf2";
const body = art[name] ?? art.harbour;
---

<svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <rect width="320" height="180" fill={background}></rect>
  <Fragment set:html={body} />
</svg>
