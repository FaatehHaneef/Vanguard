  music: `<g fill="#12344d"><circle cx="110" cy="130" r="18"/><circle cx="210" cy="116" r="18"/></g><g stroke="#12344d" stroke-width="8"><path d="M124 130V40l100-16v92"/></g><path d="M124 40l100-16v20l-100 16z" fill="#12344d"/>`,
  choir: `<g fill="#6b4c9a"><rect x="60" y="80" width="40" height="80" rx="20"/><rect x="140" y="70" width="40" height="90" rx="20"/><rect x="220" y="80" width="40" height="80" rx="20"/></g><g fill="#f3d3b5"><circle cx="80" cy="66" r="16"/><circle cx="160" cy="56" r="16"/><circle cx="240" cy="66" r="16"/></g>`,
