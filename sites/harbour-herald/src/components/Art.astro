---
// Small illustrations drawn for the paper, one per story subject. Decorative: the
// headline next to each one says what the story is about.
interface Props {
  name: string;
}
const { name } = Astro.props;

const sky: Record<string, string> = {
  ferry: "#cfe7ef", harbour: "#d6e4ec", library: "#efe4d2", school: "#e6efd6", houses: "#efe0d6",
  bus: "#dfe6f2", cranes: "#d9e3ea", shops: "#f2e6d8", boat: "#d3ebe9", sun: "#fbefcf",
  anchor: "#dbe5ee", market: "#f1e3cf", football: "#d9eed9", rowing: "#cfe6ee", runner: "#f3e2d6",
  cricket: "#e2efd9", swim: "#cfe8f0", netball: "#efdfe6", theatre: "#e9dcef", lantern: "#1f2f4a",
  gallery: "#e8e6f0", music: "#f0e3d3", choir: "#e6e0ef", film: "#2a2a3a",
};
const art: Record<string, string> = {
