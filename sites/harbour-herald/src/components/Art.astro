  harbour: `<path d="M0 130h320v50H0z" fill="#3f88a5"/><rect x="0" y="96" width="320" height="36" fill="#8a7f72"/><g fill="#5a5148"><rect x="40" y="70" width="34" height="30" rx="3"/><rect x="140" y="70" width="34" height="30" rx="3"/><rect x="240" y="70" width="34" height="30" rx="3"/></g><path d="M0 150c30-6 60 6 90 0s60-6 90 0 60 6 90 0 30-6 50 0" stroke="#d8ecf2" stroke-width="3" fill="none"/>`,
  library: `<rect x="60" y="50" width="200" height="110" fill="#b58b5c"/><path d="M50 50l110-30 110 30z" fill="#7a5532"/><g fill="#fbf8f3"><rect x="85" y="75" width="20" height="60"/><rect x="125" y="75" width="20" height="60"/><rect x="175" y="75" width="20" height="60"/><rect x="215" y="75" width="20" height="60"/></g><rect x="148" y="110" width="24" height="50" fill="#12344d"/>`,
  school: `<rect x="70" y="60" width="180" height="100" fill="#e0a458"/><path d="M60 60l100-40 100 40z" fill="#9c4a2f"/><rect x="148" y="110" width="24" height="50" fill="#12344d"/><g fill="#fbf8f3"><rect x="90" y="80" width="26" height="22"/><rect x="204" y="80" width="26" height="22"/></g><g fill="#fbf8f3"><rect x="40" y="166" width="20" height="8"/><rect x="80" y="166" width="20" height="8"/><rect x="120" y="166" width="20" height="8"/><rect x="160" y="166" width="20" height="8"/><rect x="200" y="166" width="20" height="8"/><rect x="240" y="166" width="20" height="8"/></g>`,
