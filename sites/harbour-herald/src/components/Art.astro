  netball: `<rect x="0" y="150" width="320" height="30" fill="#9b6b8b"/><path d="M220 150V40" stroke="#16202a" stroke-width="5"/><ellipse cx="200" cy="44" rx="20" ry="6" fill="none" stroke="#c2410c" stroke-width="4"/><circle cx="110" cy="90" r="18" fill="#f5b301"/>`,
  theatre: `<rect x="40" y="30" width="240" height="130" fill="#6b2d5c"/><path d="M40 30c40 50 60 80 60 130H40zM280 30c-40 50-60 80-60 130h60z" fill="#b2324d"/><circle cx="160" cy="110" r="22" fill="#f5b301" opacity="0.8"/>`,
