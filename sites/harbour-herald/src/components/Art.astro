  sun: `<circle cx="80" cy="60" r="28" fill="#f5b301"/><rect x="110" y="96" width="190" height="64" fill="#7a5532"/><path d="M100 98l100-48 110 48z" fill="#1d4e89"/><g stroke="#d8ecf2" stroke-width="2"><path d="M130 70l30-14M170 62l40-18M215 52l40 18"/></g>`,
  anchor: `<g stroke="#12344d" stroke-width="10" fill="none" stroke-linecap="round"><circle cx="160" cy="40" r="14"/><path d="M160 54v100M120 80h80M100 120c10 30 40 40 60 40s50-10 60-40"/></g>`,
