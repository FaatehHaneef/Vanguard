  bus: `<rect x="40" y="70" width="230" height="80" rx="14" fill="#c2410c"/><g fill="#d8ecf2"><rect x="56" y="84" width="36" height="28" rx="4"/><rect x="100" y="84" width="36" height="28" rx="4"/><rect x="144" y="84" width="36" height="28" rx="4"/><rect x="188" y="84" width="36" height="28" rx="4"/></g><circle cx="90" cy="152" r="14" fill="#16202a"/><circle cx="220" cy="152" r="14" fill="#16202a"/><circle cx="20" cy="40" r="10" fill="#f5b301"/>`,
