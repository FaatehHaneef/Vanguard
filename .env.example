# Copy to .env and fill in. Never commit .env.
# Lists are JSON arrays.

VANGUARD_ENV=development
VANGUARD_DATABASE_URL=postgresql+psycopg://vanguard:vanguard@localhost:5432/vanguard
VANGUARD_DATA_DIR=D:/VanguardData

VANGUARD_DEFAULT_PROVIDER=gemini
VANGUARD_ENABLED_PROVIDERS=["gemini","fake"]
# One or more keys from https://aistudio.google.com/apikey
VANGUARD_GEMINI_API_KEYS=[]

# Sites the agent may visit: Tallowmere on 3100, Willowbrook on 3101, Northgate on 3102, Riverside on 3103.
VANGUARD_ALLOWED_ORIGINS=["http://localhost:3100","http://localhost:3101","http://localhost:3102","http://localhost:3103"]

# Local runs only: other models through any OpenAI-compatible API, by name.
# Add each name to VANGUARD_ENABLED_PROVIDERS too.
# VANGUARD_OPENAI_COMPATIBLE={"ollama": {"base_url": "http://localhost:11434/v1", "model": "qwen2.5:7b"}}

# Real browser runs: playwright (needs the worker extra and Chromium) or fake.
VANGUARD_EXECUTOR=playwright
# Model price per million tokens, for cost per run (0 = free tier).
VANGUARD_PRICE_IN_PER_MTOK=0
VANGUARD_PRICE_OUT_PER_MTOK=0
