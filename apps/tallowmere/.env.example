# Copy to .env.local and fill in. Never commit .env.local.
# Braintree SANDBOX keys: sandbox.braintreegateway.com > gear icon > API > Keys.
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# Optional. If set it must be "sandbox"; anything else stops the shop from starting.
PAYMENTS_ENVIRONMENT=sandbox
# PayPal in the payment form needs a PayPal sandbox account linked in Braintree.
NEXT_PUBLIC_PAYPAL_ENABLED=false
