  "tasks": [
    {
      "id": "buy-one",
      "site_id": "tallowmere",
      "scenario": "checkout",
      "instruction": "Buy one Dusk Ember candle and complete the checkout with the sandbox test card.",
      "start_path": "/",
      "success": {
        "url_prefix": "/thanks/"
      },
      "expected": {}
    },
    {
      "id": "buy-two",
      "site_id": "tallowmere",
      "scenario": "checkout",
      "instruction": "Buy two Dusk Ember candles and complete the checkout with the sandbox test card.",
      "start_path": "/",
      "success": {
        "url_prefix": "/thanks/"
      },
      "expected": {
        "keyboard-only": "workaround: the cart + control is not keyboard reachable; adding the candle to the cart twice is the legitimate route",
        "unrestricted": "success"
      }
    },
    {
      "id": "cheapest",
      "site_id": "tallowmere",
      "scenario": "information",
      "instruction": "Find the cheapest candle in the shop and report its name and price.",
      "start_path": "/",
      "success": {
        "answer_contains": [
          "Moss Path",
          "16"
        ]
      },
      "expected": {}
    }
  ]
